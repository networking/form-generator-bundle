{
    "name": "networking/form-generator-bundle",
    "description": "This Bundle adds a form generator to the init cms bundle",
    "keywords": ["symfony", "form generator"],
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Yorkie Chadwick",
            "homepage": "http://web.networking.ch",
            "email": "y.chadwick@networking.ch"
        }
    ],
    "require": {
        "php": "^~8.4.0 || ~8.5.0",
        "networking/init-cms-bundle": "^7.4 || dev-master",
        "symfony/config": "^6.0 || ^7.0 || ^8.0",
        "openspout/openspout": "^5.3",
        "symfony/ux-live-component": "^2.0",
        "symfony/ux-twig-component": "^2.0"
    },
    "autoload": {
        "psr-4": {"Networking\\FormGeneratorBundle\\": "src"}
    },
    "minimum-stability": "dev",
    "extra": {
        "branch-alias": {
            "dev-master": "7.x-dev"
        }
    }
}
