{% extends base_template %}
{% block actions %}

{% endblock %}
{% block show %}
    <div class="card">
        <div class="card-body">
            <table class="table table-hover table-row-bordered gy-7 gs-7 dataTable no-footer">
            {% set columnNum = 5 %}
            {% for formData in object.formData %}
                {% if loop.first %}
                    <thead>
                    <tr class="fw-semibold fs-6 text-muted">
                        {% for fieldData in formData.formFields %}
                            {% if loop.index0 < columnNum %}
                                <th>
                                   {{ fieldData.label }}
                                </th>
                            {% endif %}
                        {% endfor %}
                        <th>{{ 'date'|trans({}, 'formGenerator') }}</th>
                        <th>&nbsp;</th>
                    </tr>
                    </thead>
                {% endif %}
                <tr>
                    {% for fieldData in formData.formFields %}

                        {% if loop.index0 < columnNum %}
                            <td>
                            {%- if formData.formFields | length > columnNum  %}<a data-bs-toggle="collapse" href="#collapseExampleNote{{ formData.id }}">{% endif %}
                                {%- if fieldData.value is iterable -%}
                                    {{ fieldData.value|join(', ') }}
                                {%- else -%}
                                    {{ fieldData.value}}
                                {%- endif -%}
                            {% if formData.formFields | length > columnNum  %}</a>{% endif %}
                            </td>
                        {% endif %}
                    {% endfor %}
                    <td>{{ formData.createdAt|date('d.m.Y H:i') }}</td>
                    <td>{% if formData.formFields | length > columnNum  %}
                            <a class=" btn btn-light btn-sm button-in-row " role="button" data-bs-toggle="collapse" href="#collapseExampleNote{{ formData.id }}" aria-expanded="false" aria-controls="collapseExample">
                                <i class="ki-outline ki-magnifier fs-3 menu-icon"></i></a>
                        {% endif %}
                        <a href="{{ admin.generateUrl('deleteFormEntry', {'id': object.id, 'rowId': formData.id}) }}" class=" btn btn-light btn-sm button-in-row " onClick="temp=window.confirm('{{ 'confirm_deletion'|trans({}, 'formGenerator') }}');return temp;" >
                            <i class="ki-outline ki-trash fs-3 menu-icon"></i>
                        </a>
                    </td>
                </tr>

                {#falls es mehr spalten hat als in {{ columnNum }}, restliche daten in neuer tabelle ausgeben#}
                {% if formData.formFields | length > columnNum  %}
                    <tr style="background-color: #f5f5f5" >
                        <td colspan="{{ columnNum + 2 }}" class="p-0">
                            <div class="collapse" id="collapseExampleNote{{ formData.id }}">

                                <table class="table table-hover table-compact">
                                    <thead>
                                    <tr class="sonata-ba-list-field-header ">
                                        <th>{{ 'field'|trans({}, 'formGenerator') }}</th>
                                        <th>{{ 'value'|trans({}, 'formGenerator') }}</th>
                                    </tr>
                                    </thead>
                                    <tbody class="fw-semibold text-gray-600">
                                    {% for fieldData in formData.formFields %}
                                        <tr class="sonata-ba-view-container">
                                            <td>{{ fieldData.label }}</td>
                                            <td >
                                                {% if fieldData.value is iterable %}
                                                    {{ fieldData.value|join(', ') }}
                                                {% else %}
                                                    {{ fieldData.value}}
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>

                {% endif %}
            {% endfor %}
        </table>
        </div>
        <div class="card-footer form-actions">
            {% include '@NetworkingFormGenerator/Button/export_button.html.twig' %}
            {% include '@NetworkingFormGenerator/Button/edit_button.html.twig' %}
            {% include '@NetworkingFormGenerator/Button/list_button.html.twig' %}
            {% include '@NetworkingFormGenerator/Button/delete_button.html.twig' %}
        </div>
    </div>
{% endblock %}