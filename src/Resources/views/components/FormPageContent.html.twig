<div{{ attributes }}>
    {% if formComplete %}
        <div id="formgenerator_form_{{ formObject.id }}">
            {{ formObject.thankYouText|raw }}
        </div>
    {% else %}
        {% form_theme form 'form/fields.html.twig' %}
        {{ formObject.infoText|raw }}
        {% if not isAdmin %}{{ form_start(form, {
            attr: {
                'class': 'content_form',
                'novalidate': 'novalidate',
                'data-action': 'live#action:prevent',
                'data-live-action-param': 'save'
             }
        }) }}{% endif %}

        {% for field in form %}
            <div class="row">
                <div class="col">
                    {% if field.vars.attr.placeholder|default(false) %}
                        {{ form_row(field, {attr: {'disabled': isAdmin}, row_class: 'form-group', label_attr: {'class': 'visually-hidden'}}) }}
                    {% else %}
                        {{ form_row(field, {attr: {'disabled': isAdmin}, row_class: 'form-group'}) }}
                    {% endif %}
                </div>
            </div>
        {% endfor %}
        <div class="row align-items-center">
            <p class="button">
                <button type="submit" class="btn">{{ 'Submit'|trans }}</button>
            </p>
        </div>
        {% if not isAdmin %}{{ form_end(form) }}{% endif %}
    {% endif %}
</div>
